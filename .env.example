# Copy to .env for running the binaries on the host (not needed for docker compose).
# Matches the postgres service in docker-compose.yml, which publishes 127.0.0.1:5432.
DATABASE_URL=postgres://hookmini:hookmini@127.0.0.1:5432/hookmini?sslmode=disable

HTTP_ADDR=:8080
LOG_LEVEL=info
# json for production, text for a terminal
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s
