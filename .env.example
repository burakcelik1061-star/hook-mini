# Copy to .env for running the binaries on the host (not needed for docker compose).
# Matches the postgres service in docker-compose.yml, which publishes 127.0.0.1:5432.
DATABASE_URL=postgres://hookmini:hookmini@127.0.0.1:5432/hookmini?sslmode=disable

HTTP_ADDR=:8080
LOG_LEVEL=info
# json for production, text for a terminal
LOG_FORMAT=text
# How long to wait for work in flight on SIGTERM; at least DELIVERY_TIMEOUT + 5s.
SHUTDOWN_TIMEOUT=20s

# Required by api, worker and migrate: encrypts the endpoint signing secrets
# stored in the database. One or more base64 32-byte keys, comma-separated,
# the current one first. Generate one with: openssl rand -base64 32
# Keep it safe and backed up: without it the stored secrets cannot be read.
SECRET_ENCRYPTION_KEYS=

# Never true in production: lets endpoints point at loopback, private and
# link-local addresses (needed for a receiver on your own machine).
ALLOW_PRIVATE_DESTINATIONS=false

# Delivery worker (defaults shown).
# WORKER_ID: empty means <hostname>-<pid>-<random>.
WORKER_ID=
# Attempts in flight at once, and deliveries claimed per query.
WORKER_CONCURRENCY=10
WORKER_BATCH_SIZE=10
# How long to wait for new work when the queue is empty.
WORKER_POLL_INTERVAL=500ms
# How long a claimed delivery stays reserved; at least DELIVERY_TIMEOUT + 5s.
WORKER_LEASE_DURATION=60s
# One HTTP attempt, reading the response included.
DELIVERY_TIMEOUT=15s
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BACKOFF_INITIAL=30s
DELIVERY_BACKOFF_MAX=6h
# Disable an endpoint after this many consecutive failed attempts (0 = never).
# Its pending deliveries then end as dead and can be replayed after enabling.
ENDPOINT_AUTO_DISABLE_AFTER=100

# Retention: finished deliveries (with their attempts) and the events nothing
# refers to any more are deleted after this long. 0 keeps everything forever;
# otherwise at least 24h. Deleting an event frees its idempotency key.
RETENTION_PERIOD=2160h
# How often the worker looks for expired data.
CLEANUP_INTERVAL=1h
